# Public configuration only. Copy outside the checkout and replace every example.
# Secret values belong in protected files, never in this file or the Git history.
PREFLIGHT_PROJECT_NAME=openg7-preflight-prod
PREFLIGHT_SERVER_IMAGE=openg7-preflight:replace-with-release-tag
PREFLIGHT_WEB_IMAGE=openg7-preflight-web:replace-with-release-tag
PREFLIGHT_WEB_PORT=8087
PREFLIGHT_DATABASE_URL_FILE=/etc/openg7/preflight/secrets/database-url
PREFLIGHT_POSTGRES_ADMIN_PASSWORD_FILE=/etc/openg7/preflight/secrets/postgres-admin-password
PREFLIGHT_POSTGRES_APP_PASSWORD_FILE=/etc/openg7/preflight/secrets/postgres-app-password
PREFLIGHT_POSTGRES_CA_FILE=/etc/openg7/preflight/certificates/postgres-ca.crt
PREFLIGHT_POSTGRES_CERT_FILE=/etc/openg7/preflight/certificates/postgres-server.crt
PREFLIGHT_POSTGRES_KEY_FILE=/etc/openg7/preflight/secrets/postgres-server.key
PREFLIGHT_OPENAI_API_KEY_FILE=/etc/openg7/preflight/secrets/openai-api-key
OIDC_ISSUER=https://identity.example.invalid/realms/example
OIDC_AUDIENCE=preflight-api
OIDC_JWKS_URL=https://identity.example.invalid/realms/example/protocol/openid-connect/certs
OIDC_BROWSER_CLIENT_ID=preflight-console
OIDC_BROWSER_REDIRECT_URI=https://preflight.example.invalid/
OPENAI_MODEL=replace-with-verified-model
AI_INPUT_PRICE_PER_MILLION=replace-with-verified-input-price
AI_OUTPUT_PRICE_PER_MILLION=replace-with-verified-output-price
AI_MAX_OUTPUT_TOKENS=1500
WORKER_CONCURRENCY=4
API_RATE_LIMIT=600
# Only needed with compose.traefik.yml; all values must match the existing gateway.
PREFLIGHT_TRAEFIK_NETWORK=replace-with-existing-gateway-network
PREFLIGHT_PUBLIC_HOST=preflight.example.invalid
PREFLIGHT_TRAEFIK_ENTRYPOINT=replace-with-existing-TLS-entrypoint
PREFLIGHT_TRAEFIK_CERTRESOLVER=replace-with-existing-certificate-resolver
