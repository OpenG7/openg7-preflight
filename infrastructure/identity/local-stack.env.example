# Public local configuration only. Copy to .local/identity-local.env and adapt paths.
# Existing Funding local HTTPS, Keycloak and its edge network must already be ready.
# This localhost profile verifies password assurance; production keeps mandatory MFA.
PREFLIGHT_LOCAL_SERVER_IMAGE=openg7-preflight:local-sso
PREFLIGHT_LOCAL_WEB_IMAGE=openg7-preflight-web:local-sso
PREFLIGHT_LOCAL_WEB_PORT=8444
PREFLIGHT_LOCAL_IDENTITY_NETWORK=openg7-edge
PREFLIGHT_LOCAL_CA_FILE=/absolute/path/openg7-funding-platform/traefik/certs/rootCA.pem
PREFLIGHT_LOCAL_CERT_FILE=/absolute/path/openg7-funding-platform/traefik/certs/localhost.pem
PREFLIGHT_LOCAL_KEY_FILE=/absolute/path/openg7-funding-platform/traefik/certs/localhost-key.pem
PREFLIGHT_LOCAL_OIDC_ISSUER=https://auth.openg7.test/realms/openg7
PREFLIGHT_LOCAL_OIDC_JWKS_URL=https://auth.openg7.test/realms/openg7/protocol/openid-connect/certs
PREFLIGHT_LOCAL_OIDC_AUDIENCE=preflight-api
PREFLIGHT_LOCAL_OIDC_CLIENT_ID=preflight-console
PREFLIGHT_LOCAL_OIDC_REDIRECT_URI=https://localhost:8444/
