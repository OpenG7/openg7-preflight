# Copiez en .env. Les valeurs ci-dessous sont exclusivement locales et synthétiques.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://preflight:preflight_local@127.0.0.1:55432/preflight
TEST_DATABASE_URL=postgresql://preflight:preflight_local@127.0.0.1:55432/preflight_test
AUTH_MODE=development
DEV_TENANT_ID=openg7-demo
DEV_SUBJECT=local-administrator
DEV_APPLICATIONS=funding-platform,openg7-social
DEV_ROLES=administrator
DEV_WEB_ORIGIN=http://127.0.0.1:4300
API_RATE_LIMIT=120
WORKER_CONCURRENCY=4
AI_PROVIDER=mock
# OpenAI réel : activer explicitement, renseigner un secret local et les tarifs vérifiés.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_EXTERNAL_ENABLED=false
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_MAX_OUTPUT_TOKENS=1500
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_BROWSER_CLIENT_ID=
OIDC_BROWSER_REDIRECT_URI=
WORKER_HEARTBEAT_FILE=
# Scripts de démonstration : options locales, jeton jamais affiché.
PREFLIGHT_API_URL=http://127.0.0.1:3000
PREFLIGHT_WEB_URL=http://127.0.0.1:4300
PREFLIGHT_ACCESS_TOKEN=
